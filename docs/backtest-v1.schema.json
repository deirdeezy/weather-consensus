{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Weather Consensus backtest file, version 1",
  "description": "public/backtest/<place>.json, named by backtest_file in the place file. Human guide: docs/JSON_SCHEMA.md, section backtest. Readers must ignore fields they do not know. Optional (added 27 Nov 2026). The backtest behind the Consensus tab's 'Tested on real weather' card: the consensus and one model alone (`baseline`) rebuilt day by day on archived forecasts, each day using only data from before it, scored against the station. Written by backend/scripts/backtest.py. Deg C and mm.",
  "type": "object",
  "required": [
    "basis",
    "station",
    "scored_from",
    "scored_to",
    "method",
    "baseline",
    "leads"
  ],
  "properties": {
    "basis": {
      "const": "backtest"
    },
    "station": {
      "type": "object",
      "required": [
        "network",
        "id",
        "name"
      ],
      "properties": {
        "network": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      }
    },
    "scored_from": {
      "$ref": "#/$defs/date"
    },
    "scored_to": {
      "$ref": "#/$defs/date"
    },
    "warmup_from": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "method": {
      "type": "object",
      "required": [
        "past_data_only"
      ],
      "properties": {
        "past_data_only": {
          "type": "boolean"
        },
        "history": {
          "type": "string"
        },
        "habit_days": {
          "type": "integer"
        },
        "weight_days": {
          "type": "integer"
        }
      }
    },
    "baseline": {
      "type": "string"
    },
    "leads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "lead",
          "high",
          "low",
          "rain"
        ],
        "properties": {
          "lead": {
            "$ref": "#/$defs/lead"
          },
          "high": {
            "$ref": "#/$defs/tested_temp"
          },
          "low": {
            "$ref": "#/$defs/tested_temp"
          },
          "rain": {
            "type": "object",
            "required": [
              "consensus",
              "baseline",
              "days"
            ],
            "properties": {
              "consensus": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "baseline": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "days": {
                "type": "integer",
                "minimum": 0
              },
              "brier_chance": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "brier_climatology": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0,
                "maximum": 1
              },
              "sources": {
                "$ref": "#/$defs/versus"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "lead": {
      "type": "integer",
      "minimum": 1,
      "maximum": 14
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "tested_temp": {
      "type": "object",
      "required": [
        "consensus",
        "baseline",
        "days"
      ],
      "properties": {
        "consensus": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "baseline": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "equal_weights": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "days": {
          "type": "integer",
          "minimum": 0
        },
        "sources": {
          "$ref": "#/$defs/versus"
        }
      }
    },
    "versus": {
      "description": "Each single source alone against the consensus on the same scored days (backtest).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "miss",
          "consensus",
          "days"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "miss": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "consensus": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "days": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
